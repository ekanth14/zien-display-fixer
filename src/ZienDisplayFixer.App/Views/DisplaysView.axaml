<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZienDisplayFixer.App.ViewModels"
             xmlns:conv="using:ZienDisplayFixer.App.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ZienDisplayFixer.App.Views.DisplaysView"
             x:DataType="vm:DisplaysViewModel">

    <UserControl.Resources>
        <conv:EqualityToBooleanConverter x:Key="EqualConverter" />

        <LinearGradientBrush x:Key="DuskSwatch" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#6A5A8E" Offset="0.0" />
            <GradientStop Color="#1B1630" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DuneSwatch" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#B9966B" Offset="0.0" />
            <GradientStop Color="#2E2218" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MistSwatch" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#8FA3AD" Offset="0.0" />
            <GradientStop Color="#1F2830" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GraphiteSwatch" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#3A3F4C" Offset="0.0" />
            <GradientStop Color="#0D0F13" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.Swatch">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#27272D" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Swatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppMuted}" />
        </Style>
        <Style Selector="Button.Swatch.Active">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>
        <Style Selector="Button.Pill.Active">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24" HorizontalAlignment="Stretch" MaxWidth="840">
            <Border Classes="Card"
                    Padding="28"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="24">
                    <!-- Section Title -->
                    <TextBlock Text="Your setup"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppText}" />

                    <!-- Device Selection & Screen Size Grid -->
                    <Grid ColumnDefinitions="Auto,32,Auto" VerticalAlignment="Center">
                        <!-- Device Field -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Your device" Classes="Muted" FontSize="13" />
                            <Border Classes="SegmentedGroup" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SegmentedItem"
                                            Classes.Active="{Binding DeviceType, Converter={StaticResource EqualConverter}, ConverterParameter=Laptop}"
                                            Content="Laptop"
                                            Command="{Binding SetDeviceTypeCommand}"
                                            CommandParameter="Laptop" />
                                    <Button Classes="SegmentedItem"
                                            Classes.Active="{Binding DeviceType, Converter={StaticResource EqualConverter}, ConverterParameter=Pc}"
                                            Content="PC"
                                            Command="{Binding SetDeviceTypeCommand}"
                                            CommandParameter="Pc" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Laptop Screen Size (hidden when PC) -->
                        <StackPanel Grid.Column="2"
                                    Spacing="8"
                                    IsVisible="{Binding IsLaptop}">
                            <TextBlock Text="Screen size" Classes="Muted" FontSize="13" />
                            <Border Classes="SegmentedGroup" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding LaptopScreenSizes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="SegmentedItem"
                                                    Classes.Active="{Binding $parent[UserControl].((vm:DisplaysViewModel)DataContext).SelectedLaptopScreenSize, Converter={StaticResource EqualConverter}, ConverterParameter={Binding}}"
                                                    Content="{Binding, StringFormat='{}{0}&quot;'}"
                                                    Command="{Binding $parent[UserControl].((vm:DisplaysViewModel)DataContext).SetLaptopScreenSizeCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Wallpaper Section -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Desk wallpaper" Classes="Muted" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- Dusk -->
                            <Button Classes="Swatch"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=Dusk}"
                                    Background="{StaticResource DuskSwatch}"
                                    Command="{Binding SetWallpaperPresetCommand}"
                                    CommandParameter="Dusk"
                                    ToolTip.Tip="Dusk gradient" />

                            <!-- Dune -->
                            <Button Classes="Swatch"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=Dune}"
                                    Background="{StaticResource DuneSwatch}"
                                    Command="{Binding SetWallpaperPresetCommand}"
                                    CommandParameter="Dune"
                                    ToolTip.Tip="Dune gradient" />

                            <!-- Mist -->
                            <Button Classes="Swatch"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=Mist}"
                                    Background="{StaticResource MistSwatch}"
                                    Command="{Binding SetWallpaperPresetCommand}"
                                    CommandParameter="Mist"
                                    ToolTip.Tip="Mist gradient" />

                            <!-- Graphite -->
                            <Button Classes="Swatch"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=Graphite}"
                                    Background="{StaticResource GraphiteSwatch}"
                                    Command="{Binding SetWallpaperPresetCommand}"
                                    CommandParameter="Graphite"
                                    ToolTip.Tip="Graphite gradient" />

                            <!-- OS System Wallpaper Button -->
                            <Button Classes="Pill"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=System}"
                                    Content="System"
                                    Command="{Binding UseSystemWallpaperCommand}"
                                    Margin="12,0,0,0"
                                    ToolTip.Tip="Use system wallpaper" />

                            <!-- Custom Upload Button -->
                            <Button Classes="Pill"
                                    Classes.Active="{Binding SelectedWallpaperPreset, Converter={StaticResource EqualConverter}, ConverterParameter=Upload}"
                                    Content="Upload"
                                    Command="{Binding UploadWallpaperCommand}"
                                    ToolTip.Tip="Upload custom wallpaper image" />
                        </StackPanel>

                        <!-- Hint Text -->
                        <TextBlock Text="{Binding WallpaperHintText}"
                                   Classes="Muted"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="{DynamicResource AppBorder}" />

                    <!-- Displays Header -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Connected displays"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppText}" />
                        <TextBlock Text="Hardware monitors detected from your graphics adapter and EDID"
                                   Classes="Muted"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- Empty state if no displays detected -->
                    <Border IsVisible="{Binding !HasDisplays}"
                            Background="#16161B"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No external displays detected"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="Connect an external monitor via HDMI, DisplayPort, or USB-C to extend your workspace."
                                       Classes="Muted"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Connected Displays List -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  IsVisible="{Binding HasDisplays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayItemViewModel">
                                <Border Background="#16161B"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="20"
                                        Margin="0,0,0,14">
                                    <StackPanel Spacing="14">
                                        <!-- Card Header: Title & Badges -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource AppBorder}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayNumberText}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AppAccent}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AppText}" />
                                                <TextBlock Text="Primary Display"
                                                           IsVisible="{Binding IsPrimary}"
                                                           Foreground="{DynamicResource AppOk}"
                                                           FontSize="11"
                                                           FontWeight="Medium" />
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="#20CDB78F"
                                                    BorderBrush="{DynamicResource AppAccent}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,3">
                                                <TextBlock Text="{Binding ConnectionText}"
                                                           Foreground="{DynamicResource AppAccent}"
                                                           FontSize="12"
                                                           FontWeight="Medium" />
                                            </Border>
                                        </Grid>

                                        <!-- Specifications Grid -->
                                        <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                            <!-- Size & Aspect Ratio -->
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Physical Size" Classes="Muted" FontSize="11" />
                                                <TextBlock Text="{Binding PhysicalSizeText}"
                                                           Foreground="{DynamicResource AppText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                            </StackPanel>

                                            <!-- Active Mode -->
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Current Mode" Classes="Muted" FontSize="11" />
                                                <TextBlock Text="{Binding CurrentModeText}"
                                                           Foreground="{DynamicResource AppText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                            </StackPanel>

                                            <!-- Native / Recommended Mode -->
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="Native Mode (EDID)" Classes="Muted" FontSize="11" />
                                                <TextBlock Text="{Binding NativeModeText}"
                                                           Foreground="{DynamicResource AppOk}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Physical placement relative to the primary display -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding CanChangePlacement}">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Position on your desk"
                                                           Foreground="{DynamicResource AppText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Text="Where this screen sits relative to your main screen. Fix my screens will line it up."
                                                           Classes="Muted"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      MinWidth="130"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{x:Static vm:DisplayItemViewModel.PlacementOptions}"
                                                      SelectedItem="{Binding Placement, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
