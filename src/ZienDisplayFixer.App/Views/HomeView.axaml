<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZienDisplayFixer.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="ZienDisplayFixer.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid Margin="32">
        <Border Classes="Card" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="PageTitle" Text="Workstation &amp; Displays" HorizontalAlignment="Center" />
                <TextBlock Classes="Muted" Text="Auto-detect native resolution, optimal refresh rates, and aspect ratio." HorizontalAlignment="Center" />
                <Button Classes="ActionFix" Content="Fix my screens" Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
