<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZienDisplayFixer.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="300"
             x:Class="ZienDisplayFixer.App.Views.ModeConfirmationDialog"
             x:DataType="vm:ModeConfirmationViewModel">

    <Border Classes="Card"
            Padding="32"
            MaxWidth="460"
            CornerRadius="24"
            Background="#121215"
            BorderBrush="#27272D"
            BorderThickness="1"
            BoxShadow="0 16 48 #60000000">
        <StackPanel Spacing="20" HorizontalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="Keep these display settings?"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppText}"
                       HorizontalAlignment="Center" />

            <!-- Subtitle -->
            <TextBlock Text="If your screen is black or unreadable, settings will automatically revert."
                       Classes="Muted"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />

            <!-- Countdown Timer -->
            <Border Background="#1C1C22"
                    CornerRadius="12"
                    Padding="16,8"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Reverting in"
                               Classes="Muted"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RemainingSeconds, StringFormat='{}{0} seconds...'}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccent}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Classes="AccentPill"
                        Content="Keep settings"
                        Command="{Binding KeepCommand}" />
                <Button Classes="Pill"
                        Content="Revert now"
                        Command="{Binding RevertCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

