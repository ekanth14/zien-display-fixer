<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZienDisplayFixer.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="ZienDisplayFixer.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid Margin="32">
        <Border Classes="Card" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="PageTitle" Text="Settings" HorizontalAlignment="Center" />
                <TextBlock Classes="Muted" Text="Application preferences, autostart, and auto-optimization on connect." HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
