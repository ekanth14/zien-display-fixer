<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZienDisplayFixer.App.ViewModels"
             xmlns:views="using:ZienDisplayFixer.App.Views"
             x:Class="ZienDisplayFixer.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ZienDisplayFixer.App/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ZienDisplayFixer.App/Styles/Typography.axaml" />
        <StyleInclude Source="avares://ZienDisplayFixer.App/Styles/AppTheme.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplaysViewModel}">
            <views:DisplaysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WirelessViewModel}">
            <views:WirelessView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
